#!/bin/sh /etc/rc.common
# 确保 cfg80211 regulatory domain = CN（5G WiFi 必需）
#
# 背景（2026-11-21 真机定位）：cfg80211 若 regulatory.db 缺签名（.p7s），
# 内核判定 regdb 无效 -> 退回 world domain (country 00) -> 所有 5G 信道标记
# NO-IR（被动/禁止发射）-> hostapd 起 5G AP 时报
#   "Frequency 5745 not allowed for AP mode, flags: NO-IR"
#   "DFS start_dfs_cac() failed" -> 5G 永远不广播。
# 修复：files/lib/firmware/regulatory.db + .p7s 提供带签名的有效数据库，
# 本脚本再兜底把 regdomain 设为 CN（只要 regdb 有效此命令即成功）。
# CN 下 5725-5850MHz（信道 149-165）无 NO-IR/无 DFS，5G HE80 正常起。
#
# 2026-11-26 补：2.4G 配置兜底。TTL 日志确认 8192XBE 已 probe、AP 固件已加载、
# phy0-ap0 已进 bridge forwarding，所以"没有 2.4G 信号"落在 hostapd/配置层。
# 历史注释（97 号脚本）明确记着"手机搜不到时把 2.4G htmode 改 HT20 再观察"
# 这一未真机复验的对策；现在真机复验失败，这里把它落地为默认值：
#   - channel 为空/auto -> 6（2.4G 通用信道，避开 12/13 的 CN 限制差异）
#   - htmode  为空/auto -> HT20（避免 HE20 信标与部分手机不兼容）
# 用户手动设定的合法值（channel 1..13、HT20/HE20 等）一律不动。

. /lib/functions.sh

START=19

WIFI24_CHANGED=0

_normalize_24g_radio() {
	local sec="$1"
	local band channel htmode country

	config_get band "$sec" band
	[ "$band" = "2g" ] || return 0

	config_get country "$sec" country
	if [ -z "$country" ]; then
		uci -q set "wireless.$sec.country=CN"
		WIFI24_CHANGED=1
	fi

	config_get channel "$sec" channel
	case "$channel" in
		''|auto)
			# 驱动推导出的 auto 在 R10 上没能广播 2.4G，落到固定信道 6
			uci -q set "wireless.$sec.channel=6"
			logger -t wifi-regdom "$sec: 2.4G channel '$channel' -> 6 (R10 default)"
			WIFI24_CHANGED=1
			;;
		*[!0-9]*)
			uci -q set "wireless.$sec.channel=6"
			logger -t wifi-regdom "$sec: 非法 2.4G channel='$channel' -> 6"
			WIFI24_CHANGED=1
			;;
		*)
			if [ "$channel" -lt 1 ] || [ "$channel" -gt 13 ]; then
				uci -q set "wireless.$sec.channel=6"
				logger -t wifi-regdom "$sec: 5G channel '$channel' 落在 2.4G radio -> 6"
				WIFI24_CHANGED=1
			fi
			;;
	esac

	config_get htmode "$sec" htmode
	case "$htmode" in
		''|auto|*80*|*160*|*320*|*6G*)
			uci -q set "wireless.$sec.htmode=HT20"
			logger -t wifi-regdom "$sec: 2.4G htmode='$htmode' -> HT20 (R10 default)"
			WIFI24_CHANGED=1
			;;
	esac
}

normalize_24g_config() {
	[ -f /etc/config/wireless ] || return 0

	WIFI24_CHANGED=0
	config_load wireless
	config_foreach _normalize_24g_radio wifi-device

	if [ "$WIFI24_CHANGED" -eq 1 ]; then
		uci -q commit wireless
		logger -t wifi-regdom "2.4G 默认值已落地（channel=6 htmode=HT20；手动合法值保持）"
	fi
	return 0
}

start() {
	# 先修配置再起 wifi（本脚本 START=19，network/wifi 在其后启动）
	normalize_24g_config

	# 已经是正确的 regdomain 就不动（幂等，避免每次开机刷日志）
	iw reg get 2>/dev/null | grep -q '^country CN:' && return 0
	iw reg set CN 2>/dev/null && \
		logger -t wifi-regdom "regulatory domain set to CN (5G AP enable)" || \
		logger -t wifi-regdom "iw reg set CN failed; check regulatory.db/.p7s"
	return 0
}
