// SPDX-License-Identifier: GPL-2.0-only
// Youhua PT1570-R10 — RTL9617C, 4xGE internal GPHY, PON, dual-band WiFi.
//
// Rewritten 2026-11-25 for the pure-refactor (Taurus) baseline d39cfc6.
// The old file included "rtl9617c-tyfza1-4ge.dts", which upstream removed in
// f75f4ca ("rewrite platform drivers as Taurus, drop rtl9617c compatibles").
// This DTS is modelled on upstream's rtl9617c-tianyi-tyfza1-2p5g.dts and uses
// the Taurus compatibles/device-tree bindings from rtk-taurus.dtsi.
//
// Verified board facts carried over from the previous (hardware-layer) DTS:
//   * 4xGE: internal GPHYs on NI port0..3; PCB routes them to the panel in
//     reverse (2026-11-14 per-jack check): port0=LAN4, port1=LAN3,
//     port2=LAN2, port3=LAN1. Ports are named by silkscreen via the DTS
//     "label" property (the Taurus NI driver reads it directly).
//   * LED GPIOs / polarities (old gpio0 global number -> new bank:pin,
//     mapping bank=floor(n/32), pin=n%32 from rtk-taurus.dtsi gpio-ranges):
//       internet 2L=b0:2, los 10L=b0:10, usb0 7H=b0:7, pon 9L=b0:9,
//       power 11H=b0:11, phone 12H=b0:12, lan0 4L=b0:4, lan1 3L=b0:3,
//       lan2 1L=b0:1, lan3 0L=b0:0, usb1 6L=b0:6, wps 5H=b0:5.
//     NOTE: "lan0..lan3" here are the SoC EPHY indices, mapped to panel
//     LAN4..LAN1 by files/etc/uci-defaults/96-pt1570-r10-leds.
//   * Keys (old global -> new): lights-toggle 103L=b3:7,
//     reset 8L=b0:8, rfkill/wifi 99L=b3:3.
//   * FIT boot: root=/dev/fit0 (uImage.FIT subimage block driver), with
//     chosen.u-boot,version as the fitblk driver's registration gate.
//   * WiFi: 5G RTL8852CE on pcie0, 2.4G RTL8192XBE on pcie1, using the
//     upstream mac80211 backport + AP firmware scheme (realtek,ap-firmware)
//     and factory calibration nvmem cells from the "factory" UBI volume.

/dts-v1/;

#include "rtk-taurus.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Youhua PT1570-R10 (RTL9617C, 4xGE, UBI)";
	compatible = "youhua,pt1570-r10", "realtek,rtl9617c";

	aliases {
		serial0 = &uart0;
		i2c0 = &i2c0;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		// root=/dev/fit0 + u-boot,version gate: FIT rootfs is self-contained,
		// independent of the bootloader injecting a root= bootarg (the stock
		// qwe-qaq U-Boot does not). /dev/fit0 (not fitblk0) is the block device
		// exported by the uImage.FIT subimage block driver; see 510/511 patches.
		u-boot,version = "2025.01";
		bootargs = "earlycon console=ttyS0,115200n8 loglevel=7 clk_ignore_unused maxcpus=4 root=/dev/fit0 rootwait rootfstype=squashfs";
		rootdisk = <&ubi_rootdisk>;
	};

	memory@0 {
		device_type = "memory";
		reg = <0 0 0 0x20000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		lan_deepq: lan-deepq@c000000 {
			reg = <0 0x0c000000 0 0x01500000>;
		};
		tz-smc@eeff000 {
			reg = <0 0x0eeff000 0 0x1000>;
			no-map;
		};
		ramoops@ff80000 {
			compatible = "ramoops";
			reg = <0 0x0ff80000 0 0x40000>;
			record-size = <0x10000>;
			console-size = <0x10000>;
			pmsg-size = <0x10000>;
		};
		tz@ffc0000 {
			reg = <0 0x0ffc0000 0 0x40000>;
		};
	};

	leds {
		compatible = "gpio-leds";

		internet {
			label = "LED_PPP_G";
			gpios = <&gpio_bank0 2 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
		los {
			label = "LED_LOS";
			gpios = <&gpio_bank0 10 GPIO_ACTIVE_LOW>;
		};
		pon {
			label = "LED_PON";
			gpios = <&gpio_bank0 9 GPIO_ACTIVE_LOW>;
		};
		led_power: power {
			label = "LED_PWR_G";
			gpios = <&gpio_bank0 11 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
		phone {
			label = "LED_FXS";
			gpios = <&gpio_bank0 12 GPIO_ACTIVE_HIGH>;
		};
		usb0 {
			label = "LED_USB0";
			gpios = <&gpio_bank0 7 GPIO_ACTIVE_HIGH>;
		};
		usb1 {
			label = "LED_USB1";
			gpios = <&gpio_bank0 6 GPIO_ACTIVE_LOW>;
		};
		wps {
			label = "LED_WPS_G";
			gpios = <&gpio_bank0 5 GPIO_ACTIVE_HIGH>;
		};
		// SoC EPHY0..3 -> panel LAN4..LAN1 (see 96-pt1570-r10-leds).
		lan0 {
			label = "LED_EPHY0";
			gpios = <&gpio_bank0 4 GPIO_ACTIVE_LOW>;
		};
		lan1 {
			label = "LED_EPHY1";
			gpios = <&gpio_bank0 3 GPIO_ACTIVE_LOW>;
		};
		lan2 {
			label = "LED_EPHY2";
			gpios = <&gpio_bank0 1 GPIO_ACTIVE_LOW>;
		};
		lan3 {
			label = "LED_EPHY3";
			gpios = <&gpio_bank0 0 GPIO_ACTIVE_LOW>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		btn-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio_bank0 8 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
		btn-wifi {
			label = "rfkill";
			linux,code = <KEY_RFKILL>;
			gpios = <&gpio_bank3 3 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
		lights-toggle {
			label = "lights-toggle";
			linux,code = <KEY_LIGHTS_TOGGLE>;
			gpios = <&gpio_bank3 7 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

&gpio0 {
	status = "okay";
};

&i2c0 {
	status = "okay";

	bosa0: optical-front-end@51 {
		compatible = "realtek,rtl9617c-bosa";
		reg = <0x51>;
		nvmem-cells = <&bosa_calibration>;
		nvmem-cell-names = "calibration";
	};
};

&mdio {
	status = "okay";

	phy1: ethernet-phy@1 {
		reg = <1>;
	};
	phy2: ethernet-phy@2 {
		reg = <2>;
	};
	phy3: ethernet-phy@3 {
		reg = <3>;
	};
	phy4: ethernet-phy@4 {
		reg = <4>;
	};
};

&ni {
	memory-region = <&lan_deepq>;
	nvmem-cells = <&base_mac 0>;
	nvmem-cell-names = "mac-address";
	status = "okay";

	ethernet-ports {
		// PCB is reverse-wired: NI port0..3 -> panel LAN4..LAN1.
		// The Taurus NI driver names each netdev from the DTS "label".
		port@0 {
			reg = <0>;
			label = "lan4";
			nvmem-cells = <&base_mac 4>;
			nvmem-cell-names = "mac-address";
			phy-mode = "internal";
			phy-handle = <&phy1>;
		};
		port@1 {
			reg = <1>;
			label = "lan3";
			nvmem-cells = <&base_mac 3>;
			nvmem-cell-names = "mac-address";
			phy-mode = "internal";
			phy-handle = <&phy2>;
		};
		port@2 {
			reg = <2>;
			label = "lan2";
			nvmem-cells = <&base_mac 2>;
			nvmem-cell-names = "mac-address";
			phy-mode = "internal";
			phy-handle = <&phy3>;
		};
		port@3 {
			reg = <3>;
			label = "lan1";
			nvmem-cells = <&base_mac 1>;
			nvmem-cell-names = "mac-address";
			phy-mode = "internal";
			phy-handle = <&phy4>;
		};
	};
};

&pcie0 {
	// 板载 8852CE 的 PERST#：不释放复位时链路停在 POLL_COMPLIANCE，
	// 卡不会被枚举，也就没有 phy0/wlan0。上层 tianyi DTS 同样配置。
	reset-gpios = <&gpio_bank3 5 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&pcie0_port {
	// 5 GHz RTL8852CE. AP firmware + RFE54 tables come from the upstream
	// mac80211 backport patches (100-103) and rtl8852ce-ap-firmware package.
	wifi5g: wifi@0,0 {
		compatible = "pci10ec,c852";
		reg = <0x0000 0 0 0 0>;
		realtek,ap-firmware;
		realtek,rfe-type = <54>;
		ieee80211-freq-limit = <5150000 5900000>;
		nvmem-cells = <&wifi_cal_radio0>;
		nvmem-cell-names = "wifi-calibration";
	};
};

&pcie1 {
	// 板载 8192XBE 的 PERST#
	reset-gpios = <&gpio_bank3 6 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&pcie1_port {
	// 2.4 GHz RTL8192XBE.
	wifi2g: wifi@0,0 {
		compatible = "pci10ec,0192";
		reg = <0x0000 0 0 0 0>;
		realtek,rfe-type = <54>;
		nvmem-cells = <&wifi_cal_radio1>;
		nvmem-cell-names = "wifi-calibration";
	};
};

&pon {
	status = "okay";
	nvmem-cells = <&epon_mac 0>, <&base_mac 0>, <&pon_sn>;
	nvmem-cell-names = "mac-address", "base-mac", "pon-serial";
	realtek,optical-front-end = <&bosa0>;
	tx-disable-gpios = <&gpio_bank0 15 GPIO_ACTIVE_HIGH>;
	realtek,burst-polarity = <0>;
	realtek,los-invert = <0>;
	realtek,uni-ports = /bits/ 8 <3 2 1 0>;
};

&qspi {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x0 0x200000>;
				read-only;
			};
			partition@280000 {
				label = "env";
				reg = <0x280000 0x40000>;
			};
			partition@2c0000 {
				label = "env2";
				reg = <0x2c0000 0x40000>;
			};
			partition@300000 {
				label = "static_conf";
				reg = <0x300000 0x40000>;
			};

			ubi_partition: partition@340000 {
				label = "ubi_device";
				reg = <0x340000 0xf5c0000>;
				compatible = "linux,ubi";
				// Rootfs_data overlay needs this volume writable. refactor's
				// rtk-taurus.dtsi does not mark partitions read-only, so no
				// /delete-property/ read-only override is needed here.

				volumes {
					ubi_rootdisk: ubi-volume-fit {
						volname = "fit";
					};

					ubi_factory: ubi-volume-factory {
						volname = "factory";

						nvmem-layout {
							compatible = "fixed-layout";
							#address-cells = <1>;
							#size-cells = <1>;

							base_mac: mac-address@1000 {
								compatible = "mac-base";
								reg = <0x1000 0x6>;
								#nvmem-cell-cells = <1>;
							};

							mac_count: mac-count@1006 {
								reg = <0x1006 0x4>;
							};

							epon_mac: mac-address@1010 {
								compatible = "mac-base";
								reg = <0x1010 0x6>;
								#nvmem-cell-cells = <1>;
							};

							pon_sn: pon-serial@1020 {
								reg = <0x1020 0x10>;
							};

							device_sn: device-serial@1030 {
								reg = <0x1030 0x20>;
							};

							wifi_cal_radio0: wifi-calibration@2000 {
								reg = <0x2000 0x1000>;
							};

							wifi_cal_radio1: wifi-calibration@3000 {
								reg = <0x3000 0x1000>;
							};

							bosa_calibration: bosa-calibration@4000 {
								reg = <0x4000 0x400>;
							};

							bosa_olt_calibration: olt-calibration@4800 {
								reg = <0x4800 0x400>;
							};

							fpga_image: fpga-image@10000 {
								reg = <0x10000 0x7e0000>;
							};
						};
					};
				};
			};
		};
	};
};

/* SoC TMS sensor reads 12C low per factory xtemp calibration; report raw + 12C */
&cpu_thermal {
	deviation = <0xffffd120>;
};

&serdes {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&watchdog {
	reset-on-timeout;
	delay-reset = <134>;
	status = "okay";
};

&usb_hsphy {
	status = "okay";
};

&usb_ssphy {
	status = "okay";
};

&usb3 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	usb_port1: port@1 {
		reg = <1>;
		#trigger-source-cells = <0>;
	};
};
