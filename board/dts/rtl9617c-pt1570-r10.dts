// SPDX-License-Identifier: GPL-2.0-only
//
// VERIFIED (2026-11-13)。已按真机 FDT 完成静态移植，并经真机启动验证：
//   * initramfs-recovery 在 R10 上正常启动（2026-11-12/13 多轮）；
//   * fitblk/FIT ABI 链路已按真机串口修正（/dev/fit0 设备名）；
//   * rtl8852ce(5G) / rtl8192xbe(2.4G) 在 PCIe0/PCIe1 上 probe 成功、
//     SSID 正常广播（2026-11-13 真机联机验证）。
//
// FDT_VERIFIED (2026-11-09)：以下字段来自 PT1570-R10 真机 /proc/device-tree
// 只读导出（pt1570-ci-research/r10-fdt-dump-20261109.txt，447 个属性），
// 并与 dreamtekcat/PonWRT-TYFZA1@pt1570 的 port/overlay DTS 交叉核对。
//
// FIT ABI 部分完全由上游 rtl9617c-tyfza1.dtsi 提供，本文件不重复：
//   chosen.rootdisk = <&ubi_rootdisk>
//   ubi-volume-fit      { volname = "fit"; }
//   ubi-volume-factory  { volname = "factory"; nvmem-layout { ... }; }
//   分区 ubi_device <0x340000 0xf5c0000> —— 与真机 FDT 实测一致。
//
// ---- 已实证一致（由 include 的上游 4GE 定义提供，无需覆盖） ----
//   * 4×GE：realtek,lan-phys 是 4 个 phandle，指向 mdio 的 phy@1..phy@4
//     （reg 1/2/3/4，内部 GPHY）；真机 dmesg 也报 PHY 001ccac4、lan1..lan4。
//   * 面板接线顺序（2026-11-14 用户真机逐口插线验证）：NI port0..3 反序对应
//     面板 LAN4..LAN1，即 port0=LAN4、port1=LAN3、port2=LAN2、port3=LAN1。
//     驱动命名由 patch-upstream.sh 按 index = 4 - port 修正（lan1..lan4 对号入座），
//     面板灯由 files/etc/uci-defaults/96-pt1570-r10-leds 纠正（EPHY0..3=LAN4..LAN1）。
//   * 12 个 LED 的 GPIO 与极性逐项一致（L=低有效 / H=高有效）：
//       internet 2L, los 10L, usb0 7H, pon 9L, power 11H, phone 12H,
//       lan0 4L, lan1 3L, lan2 1L, lan3 0L, usb1 6L, wps 5H
//   * flash 分区表 5 个分区与真机 /proc/mtd 一致。
//   * chosen / stdout-path、PON、PCIe0/PCIe1、USB、BOSA 节点由 dtsi 提供。
//
// ---- 已实证不一致、本文件覆盖 ----
//   * 按键：上游 dtsi 只有 lights-toggle(gpio 67)；真机有三键，见下方节点。
//
// ⛔ 不得改用 2.5G 板定义：它会引入一颗外置 2.5G PHY、把网口映射改成
//    NI 端口 0/1/2/4，并换成另一套 LED GPIO。R10 是 4×GE，误用会直接
//    导致 LAN 不通。这是 2026-11-09 真机核对后修正的实质缺陷。
//
// ---- 遗留小项（不阻塞 verified，属外围功能） ----
//   1. U-Boot Web Failsafe 网口在 R10（4×GE）上未单独实测；
//   2. LED / 按键已在 initramfs 态部分观察，未逐键复测；
//   3. 刷入态（sysupgrade.itb）的完整启动流程待新固件刷入后最终确认。
//
// 上述遗留项均为外围功能，不影响核心启动 / 网络 / 无线，不再阻塞 verified。
//
// 注意：不要在此文件写 /dts-v1/；被 include 的 .dts 已经带了该标记。

#include "rtl9617c-tyfza1-4ge.dts"

/ {
	// 概览标记（LuCI「型号」= 这里的 model 字符串）：
	//   ... UBI  = 本仓库 2026-11-16 之后的固件（支持系统内升级，见 apply-board.sh 3b）
	//   之前是 "... FIT ABI"：旧固件的系统内升级静默失败，只能 uboot 刷。
	// 换标记是为了让「看概览就知道刷没刷进去」（朋友 2026-11-16 实证的思路）。
	model = "Youhua PT1570-R10 (RTL9617C, 4xGE, UBI)";
	compatible = "youhua,pt1570-r10", "tianyi,tyfza1-4ge", "realtek,rtl9617c";

	/*
	 * FIT rootfs 自洽启动（2026-11-10 起，2026-11-13 修正设备名）
	 *
	 * 上游 dtsi 的 bootargs 只有 console/loglevel，没有 root=。它依赖
	 * bootloader 把 /chosen/rootdisk 翻译成 root= 注入 —— 而
	 * qwe-qaq/rtl9617c-uboot@4c13f1b7 里根本没有 rootdisk/fitblk 代码
	 * （代码搜索 fitblk / rootdisk 命中 0），rtk_boot 也只是
	 * `ubi part; ubi read; bootm`，env 里连 bootargs 都没有。
	 * 结果内核拿不到 root=，挂根失败。
	 *
	 * 这里直接把 root= 写进 DTS，让固件自洽，不依赖 bootloader：
	 *   root=/dev/fit0     —— generic/pending-6.18/510-block-add-uImage.FIT-
	 *                         subimage-block-driver.patch 把 FIT 里
	 *                         type="filesystem" 且被 config.loadables 引用的
	 *                         rootfs 子镜像映射成块设备；
	 *   rootwait           —— 511-init-bypass-device-lookup-for-dev-fit-rootfs
	 *                         让 init 对 "fit*" 走 Root_Generic 并等待；
	 *   rootfstype=squashfs—— 免探测。
	 *
	 * ⛔ 设备名是 /dev/fit0，不是 /dev/fitblk0（2026-11-13 更正）：
	 *    "fitblk" 只是 platform driver / platform device 的名字，
	 *    暴露给用户态的块设备名来自 FIT_DEVICE_PREFIX：
	 *      #define FIT_DEVICE_PREFIX "fit"
	 *      snprintf(disk->disk_name, ..., FIT_DEVICE_PREFIX "%u", slot);
	 *    即只读 rootfs 依次是 /dev/fit0、/dev/fit1…，分区尾部余量卷是
	 *    /dev/fitrw。把驱动名当设备名（写成 fitblk0）时内核永远等不到
	 *    该设备，rootwait 之后直接 "VFS: Cannot open root device"。
	 *    511 补丁里匹配的也是 "fit" 三字符前缀，可反向印证。
	 *
	 * u-boot,version 是 fitblk 驱动的"门闩"：驱动 init 里
	 *   ubootver = of_get_property(of_chosen, "u-boot,version", NULL);
	 *   if (!ubootver) return 0;          // 静默不注册
	 * qwe-qaq 的 U-Boot 不写这个属性，所以这里补一个。属性值不参与判断。
	 */
	chosen {
		u-boot,version = "2025.01";
		bootargs = "earlycon console=ttyS0,115200n8 loglevel=7 clk_ignore_unused maxcpus=4 root=/dev/fit0 rootwait rootfstype=squashfs";
	};

	/*
	 * ubi_device 分区的 read-only 在本文件末尾的 &qspi 覆盖块里删除，
	 * 原因见那里的注释（UBI 只读会直接导致刷入态启动失败）。
	 */

	// 覆盖上游 dtsi 的 led-button：修正 lights 引脚，补齐 reset / wifi。
	// DTC 会合并同名节点，同名子节点按后写覆盖。
	// 真机 FDT 实测（gpios 三元组 phandle / pin / flags）：
	//   lights_toggle  pin=103 flags=1  linux,code=0x21e
	//   reset          pin=8   flags=1  linux,code=0x198
	//   rfkill         pin=99  flags=1  linux,code=0xf7
	led-button {
		lights-toggle {
			gpios = <&gpio0 103 GPIO_ACTIVE_LOW>;
		};

		btn-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		btn-wifi {
			label = "rfkill";
			linux,code = <KEY_RFKILL>;
			gpios = <&gpio0 99 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

/*
 * ubi_device 分区必须可写（2026-11-12 真机定位）
 *
 * 上游 rtl9617c-tyfza1.dtsi 给 5 个分区都写了 read-only，并用
 * 110-spinand-readonly.patch 在 spinand_probe 里把带 read-only 的 MTD
 * 的 MTD_WRITEABLE 清掉。于是内核把 mtd4 判成写保护，UBI 以只读方式 attach：
 *   ubi0: MTD device 4 is write-protected, attach in read-only mode
 *   ubimkvol -> error 30 (Read-only file system)
 * 结果 rootfs_data（刷机后整卷 0xFF）永远无法格式化成 ubifs，mount_root
 * 建不出 overlay，刷入态启动必然失败。这里只放开 ubi_device；
 * boot / env / env2 / static_conf 保持只读。
 */
&qspi {
	flash@0 {
		partitions {
			partition@340000 {
				/delete-property/ read-only;
			};
		};
	};
};
