--- a/target/linux/rtl9617c/image/Makefile
+++ b/target/linux/rtl9617c/image/Makefile
@@ -77,4 +77,33 @@
 endef
 TARGET_DEVICES += youhua_pt1500_h10_2p5g
 
+define Device/youhua_pt1570_r10
+  DEVICE_VENDOR := Youhua
+  DEVICE_MODEL := PT1570-R10
+  DEVICE_VARIANT := FIT-4GE
+  # image.mk turns every '_' into ',' (youhua_pt1570_r10 -> youhua,pt1570,r10),
+  # which does not match the DTS compatible "youhua,pt1570-r10". Set it explicitly
+  # so sysupgrade does not reject the image as "not supported by this image".
+  SUPPORTED_DEVICES += youhua,pt1570-r10
+  DEVICE_DTS := rtl9617c-pt1570-r10
+  DEVICE_DTS_DIR := ../dts
+  DEVICE_PACKAGES := fitblk kmod-rtl-ax-ap tyfza1-pon-control luci-app-tyfza1-pon \
+	luci-theme-argon ucode-mod-math kmod-usb3 kmod-usb-storage kmod-usb-storage-uas \
+	block-mount kmod-fs-ext4 kmod-fs-vfat kmod-nls-utf8 kmod-gpio-button-hotplug \
+	iw wpad-mbedtls wifi-scripts wireless-regdb \
+	luci luci-ssl luci-proto-ppp luci-app-firewall uhttpd uhttpd-mod-ubus \
+	firewall4 dnsmasq luci-i18n-base-zh-cn luci-i18n-firewall-zh-cn \
+	zoneinfo-core zoneinfo-asia
+  KERNEL := kernel-bin | gzip
+  KERNEL_INITRAMFS := kernel-bin | gzip | \
+	fit gzip $$(KDIR)/image-rtl9617c-pt1570-r10.dtb with-initrd | pad-to 128k
+  KERNEL_INITRAMFS_SUFFIX := -recovery.itb
+  FILESYSTEMS := squashfs
+  IMAGES := sysupgrade.itb
+  IMAGE/sysupgrade.itb := append-kernel | \
+	fit gzip $$(KDIR)/image-rtl9617c-pt1570-r10.dtb external-static-with-rootfs | \
+	pad-rootfs | append-metadata
+endef
+TARGET_DEVICES += youhua_pt1570_r10
+
 $(eval $(call BuildImage))
